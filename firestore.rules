rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ──────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userRole() {
      return isAuth() ? userDoc().data.role : null;
    }

    function isAdmin() {
      // Admin rights come only from users/{uid}.role — never from the email in
      // the token. The old email fallback let anyone who could create an account
      // with that address (the public Auth REST API allows any address) act as
      // admin, which is exactly what the leaked admin password made trivial.
      return isAuth() && userRole() == 'admin';
    }

    // ── contacts — public contact form submissions ───────────────

    match /contacts/{docId} {
      // Anyone (even unauthenticated visitors) can submit
      allow create: if true;
      // Submissions are private — no public read/update/delete
      allow read, update, delete: if false;
    }

    // ── users — profile documents keyed by Auth UID ──────────────

    match /users/{uid} {
      // Users can read their own profile; admins can read any
      allow read: if isAuth() && (request.auth.uid == uid || isAdmin());

      // A user may self-provision ONLY a family (swimmer) profile. Coach and
      // admin roles are granted server-side (Admin SDK) or by an existing admin,
      // so a client can never raise its own privileges.
      allow create: if isAuth() && request.auth.uid == uid
                    && request.resource.data.role == 'swimmer';
      // Admins can create users with any role (e.g., creating coaches)
      allow create: if isAdmin();

      // Users can update their own profile but CANNOT change their role
      allow update: if isAuth() && request.auth.uid == uid
                    && request.resource.data.role == resource.data.role;
      // Admins can update any user profile
      allow update: if isAdmin();

      // User documents cannot be deleted through the client SDK
      allow delete: if false;
    }

    // ── registrations — family registration data ─────────────────

    match /registrations/{uid} {
      // Any authenticated user can read (needed for spouse email lookup)
      allow read: if isAuth();

      // Owner creates their own; admin can create any
      allow create: if isAuth() && request.auth.uid == uid;

      // Owner, editors (spouse), parentEmails match, and admin can update
      allow update: if isAuth() && (
        request.auth.uid == uid ||
        request.auth.uid in resource.data.editors ||
        request.auth.token.email in resource.data.parentEmails ||
        isAdmin()
      );

      // Soft-delete only (done via update), never hard-delete from client
      allow delete: if false;
    }

    // ── coaches — pre-authorized coach emails (public read for signup check) ─

    match /coaches/{docId} {
      // Anyone can check if their email is authorized (used during sign-up)
      allow read: if true;
      // Only admins can create or delete coach docs
      allow create, delete: if isAdmin();
      // Admin: full update. Authorized user: only status + registeredUid.
      allow update: if isAdmin() || (
        isAuth() &&
        request.auth.token.email != null &&
        request.auth.token.email == resource.data.email &&
        // lock down: non-admin can only change status and registeredUid
        request.resource.data.email == resource.data.email &&
        request.resource.data.displayName == resource.data.displayName &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.createdBy == resource.data.createdBy
      );
    }

    // ── meets — swim meets (admin-managed, coach read-only) ─────

    match /meets/{docId} {
      // All authenticated users can view meets
      allow read: if isAuth();
      // Only admins can create, update, or delete meets
      allow create, update, delete: if isAdmin();
    }

    // ── sessionSlots — season practice slots (admin-managed, authenticated read) ─

    match /sessionSlots/{docId} {
      // All authenticated users can view the season schedule
      allow read: if isAuth();
      // Only admins create/update/delete slots and capacities
      allow create, update, delete: if isAdmin();
    }

    // ── enrollments — swimmer sign-ups per slot (admin-managed) ─

    match /enrollments/{docId} {
      // Authenticated users may read (kept open for the future family view)
      allow read: if isAuth();
      // Only admins mark/update/remove enrollments
      allow create, update, delete: if isAdmin();
    }

    // ── families — pre-authorized family emails (public read for signup check) ─

    match /families/{docId} {
      // Anyone can check if their email is authorized (used during sign-up)
      allow read: if true;
      // Only admins can add/remove authorized families
      allow create, delete: if isAdmin();
      // Admin: full update. Authorized user: only status + registeredUid.
      allow update: if isAdmin() || (
        isAuth() &&
        request.auth.token.email != null &&
        request.auth.token.email == resource.data.email &&
        // lock down: non-admin can only change status and registeredUid
        request.resource.data.email == resource.data.email &&
        request.resource.data.parentName == resource.data.parentName &&
        request.resource.data.createdBy == resource.data.createdBy
      );
    }

    // ── deposits — swimmer deposit tracking (coach/admin-managed) ─

    match /deposits/{docId} {
      // All authenticated users can view deposits
      allow read: if isAuth();
      // Only coaches and admins can create, update, or delete deposits
      allow create, update, delete: if isAdmin();
    }

    // ── volunteerHours — per-meet family volunteer hours ──────────

    match /volunteerHours/{docId} {
      // Coaches and admins read the whole season. Families are deliberately NOT
      // granted access yet: the family-side "our volunteer hours" view is a later
      // phase. When it lands, the doc already carries `familyId` + `parentEmails`,
      // so the read rule becomes:
      //   resource.data.familyId == request.auth.uid ||
      //   request.auth.token.email in resource.data.parentEmails
      allow read: if userRole() == 'coach' || userRole() == 'admin';
      // Hours are entered and corrected by admins only (decided 2026-09-21).
      // To let any coach record hours later, add `|| userRole() == 'coach'` here.
      allow create, update, delete: if isAdmin();
    }

    // ── swimResults — USA Swimming times data ──────────────────────

    match /swimResults/{docId} {
      // All authenticated users (families + coaches) can read
      allow read: if isAuth();
      // Only coaches and admins can write (batch fetch results)
      allow create, update: if userRole() == 'coach' || userRole() == 'admin';
      allow delete: if isAdmin();
    }

    // ── settings — app configuration (API credentials, etc.) ──────

    match /settings/{docId} {
      // Only coaches and admins can read settings (contains API keys)
      allow read: if userRole() == 'coach' || userRole() == 'admin';
      // Only admins can write settings
      allow create, update, delete: if isAdmin();
    }

    // ── members — test utility only, deny all in production ──────

    match /members/{docId} {
      allow read, write: if false;
    }
  }
}
