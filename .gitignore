# Environment & secrets
.env
.env.local
credentials.json
token.json
serviceAccountKey.json

# Full-resolution team photo masters — NOT stored in this repo.
# They live outside it, in the documents folder:
#   J:\MyDocuments\GitHub\Dragon-Swim\dragon_documents\team-photos-originals-backup
# (see src/assets/team-photos/README.txt). The site only ever needs the
# downscaled copies in src/assets/team-photos/, which ARE tracked. These patterns
# are a safety net so that a stray copy of the ~30 MB originals can never be
# committed by accident. They do NOT match src/assets/team-photos/.
team-photos-originals/
team-photos-originals-backup/

# Intermediate / temp files
.tmp/
node_modules/

# Local-only operator tools — deliberately NOT synced to the repo.
# Holds things like local-tools/check-usas-endpoints.mjs, a pre-flight check for
# the swim-results fetch. Kept out of .tmp/ because .tmp/ is documented as
# disposable; see local-tools/README.md.
local-tools/

# Python
__pycache__/
*.pyc
*.pyo
venv/
.venv/

# Firebase emulators
firebase-debug.log
.firebase/

# Playwright
playwright-report/
test-results/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
